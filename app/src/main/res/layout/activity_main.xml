<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header Studio -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="26dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/logoContainer"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_logo"
                    android:clipChildren="true">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_sparkle"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="CHỦ ĐỀ 04 · ANDROID MOTION LAB"
                        android:textColor="@color/accent_primary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="0.98"
                        android:text="Animation &amp; Canvas"
                        android:textColor="@color/text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMainSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/main_subtitle"
                        android:textAppearance="@style/TextAppearance.Playground.Caption"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bàn thử nghiệm đàn hồi tương tác (Spring & Wave Field) -->
            <FrameLayout
                android:id="@+id/bannerToyBox"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_stage"
                android:clipChildren="true" />
        </LinearLayout>

        <!-- Tiêu đề phân mục -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_section"
                android:textAppearance="@style/TextAppearance.Playground.Label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="3 MODULES · 60 FPS"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Card 1: Animation Demo -->
        <LinearLayout
            android:id="@+id/cardAnimation"
            style="@style/MainCard"
            android:background="@drawable/bg_card_animation">

            <FrameLayout
                android:id="@+id/previewAnimation"
                style="@style/MainCardIconBox" />

            <LinearLayout style="@style/MainCardTextBox">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="monospace"
                    android:text="01 · PROPERTY ANIMATION"
                    android:textColor="@color/accent_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/MainCardTitle"
                    android:text="@string/card_animation_title" />

                <TextView
                    style="@style/MainCardDesc"
                    android:text="@string/card_animation_desc" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_round_button">

                <ImageView
                    style="@style/MainCardChevron"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <!-- Card 2: Canvas Drawing -->
        <LinearLayout
            android:id="@+id/cardDrawing"
            style="@style/MainCard"
            android:background="@drawable/bg_card_drawing">

            <FrameLayout
                android:id="@+id/previewDrawing"
                style="@style/MainCardIconBox" />

            <LinearLayout style="@style/MainCardTextBox">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="monospace"
                    android:text="02 · CUSTOM VIEW &amp; PATH"
                    android:textColor="@color/accent_purple"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/MainCardTitle"
                    android:text="@string/card_drawing_title" />

                <TextView
                    style="@style/MainCardDesc"
                    android:text="@string/card_drawing_desc" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_round_button">

                <ImageView
                    style="@style/MainCardChevron"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <!-- Card 3: Particle Fireworks -->
        <LinearLayout
            android:id="@+id/cardParticle"
            style="@style/MainCard"
            android:background="@drawable/bg_card_particle">

            <FrameLayout
                android:id="@+id/previewParticle"
                style="@style/MainCardIconBox" />

            <LinearLayout style="@style/MainCardTextBox">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="monospace"
                    android:text="03 · PARTICLE ENGINE"
                    android:textColor="@color/accent_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/MainCardTitle"
                    android:text="@string/card_particle_title" />

                <TextView
                    style="@style/MainCardDesc"
                    android:text="@string/card_particle_desc" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_round_button">

                <ImageView
                    style="@style/MainCardChevron"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/main_footer"
            android:textAppearance="@style/TextAppearance.Playground.Caption"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
