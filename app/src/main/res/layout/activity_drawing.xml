<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    tools:context=".drawing.DrawingActivity">

    <!-- Header Studio -->
    <LinearLayout style="@style/ScreenHeader">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/RoundIconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/draw_title"
                android:textAppearance="@style/TextAppearance.Playground.Title"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/draw_subtitle"
                android:textAppearance="@style/TextAppearance.Playground.Caption"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReplay"
            style="@style/RoundIconButton"
            android:contentDescription="Replay"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnUndo"
            style="@style/RoundIconButton"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/draw_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnRedo"
            style="@style/RoundIconButton"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/draw_redo"
            android:src="@drawable/ic_redo" />

        <ImageButton
            android:id="@+id/btnClear"
            style="@style/RoundIconButton"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/draw_clear"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- Vùng vẽ Artboard Custom View -->
    <com.example.animationcanvas.drawing.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_canvas_paper"
        android:elevation="4dp" />

    <!-- Bảng điều khiển Studio Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toolGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/toolBrush"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/toolBrush"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_brush"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/toolLine"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_line"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/toolRect"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_rect"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/toolCircle"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_circle"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/toolStar"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_star"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/toolEraser"
                style="@style/Widget.Playground.ToolButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/tool_eraser"
                android:textSize="11.5sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Tùy chọn chế độ vẽ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNeon"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:text="Nét phát sáng"
                    android:textColor="@color/tool_text"
                    android:textSize="11.5sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/tool_bg"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMirror"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:text="Đối xứng 4x"
                    android:textColor="@color/tool_text"
                    android:textSize="11.5sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/tool_bg"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:checkable="true"
                    android:text="Tô đặc hình"
                    android:textColor="@color/tool_text"
                    android:textSize="11.5sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/tool_bg"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDarkBg"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checkable="true"
                    android:text="Nền bảng tối"
                    android:textColor="@color/tool_text"
                    android:textSize="11.5sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/tool_bg"
                    app:chipStrokeWidth="0dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bảng màu họa sĩ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorPalette"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Cỡ nét -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/draw_size"
                android:textAppearance="@style/TextAppearance.Playground.Label" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="54"
                android:progressTint="@color/accent_primary"
                android:thumbTint="@color/accent_primary" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_round_button">

                <View
                    android:id="@+id/sizePreview"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
